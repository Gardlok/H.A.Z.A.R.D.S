default_layout "default"
pane_frames true
session_serialization true
pane_viewport_serialization true
scrollback_editor "hx"
copy_on_select true
mouse_mode true

themes {
    gruvbox-dark {
        fg "#D5C4A1"
        bg "#282828"
        black "#3C3836"
        red "#CC241D"
        green "#98971A"
        yellow "#D79921"
        blue "#3C8588"
        magenta "#B16286"
        cyan "#689D6A"
        white "#FBF1C7"
        orange "#D65D0E"
    }
}

theme "gruvbox-dark"
